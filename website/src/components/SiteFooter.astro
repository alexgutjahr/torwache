---
import { site } from '../config';
import Mark from './Mark.astro';
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="torwache home">
        <Mark />
        <span>torwache</span>
      </a>
    </div>

    <nav class="footer-links" aria-label="Browse links">
      <p class="footer-heading">Browse</p>
      <a href="/#how">How it works</a>
      <a href="/#permissions">Permissions</a>
      <a href="/guides/">Guides</a>
      <a href="/compare/">Comparisons</a>
    </nav>

    <nav class="footer-links" aria-label="Project links">
      <p class="footer-heading">Project</p>
      <a href={site.repositoryUrl}>Repository</a>
      <a href={site.releasesUrl}>Releases</a>
      <a href={site.issuesUrl}>Report a bug</a>
      <a href="/about/">About</a>
    </nav>

    <nav class="footer-links" aria-label="Legal links">
      <p class="footer-heading">Legal</p>
      <a href="/contact/">Contact</a>
      <a href="/privacy/#website">Privacy</a>
      <a href="/imprint/">Imprint</a>
    </nav>
  </div>
</footer>
