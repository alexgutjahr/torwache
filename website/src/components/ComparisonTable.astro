---
interface Row {
  label: string;
  torwache: string;
  competitor: string;
}

interface Props {
  competitor: string;
  rows: Row[];
}

const { competitor, rows } = Astro.props;
---

<div
  class="table-scroll"
  tabindex="0"
  role="region"
  aria-label={`torwache and ${competitor} feature comparison`}
>
  <table class="comparison-table">
    <thead>
      <tr>
        <th scope="col">What matters</th>
        <th scope="col">torwache</th>
        <th scope="col">{competitor}</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ label, torwache, competitor: competitorValue }) => (
          <tr>
            <th scope="row">{label}</th>
            <td>{torwache}</td>
            <td>{competitorValue}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
