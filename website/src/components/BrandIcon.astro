---
import type { SimpleIcon } from 'simple-icons';

interface Props {
  icon: SimpleIcon;
  class?: string;
}

const { icon, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <path d={icon.path}></path>
</svg>
